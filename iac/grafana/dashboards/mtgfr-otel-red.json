  "panels": [
    {
      "datasource": {
        "type": "grafana",
        "uid": "-- Grafana --"
      },
      "description": "Prometheus receives OTLP metrics from Alloy, but this Terraform stack does not configure spanmetrics or Tempo metrics-generator. These panels query Tempo TraceQL metrics directly from spans.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "code": {
          "language": "plaintext",
          "showLineNumbers": false,
          "showMiniMap": false
        },
        "content": "## mtgfr OTEL RED\n\nRate, errors, and p95 latency are computed from Tempo TraceQL metrics over spans emitted by `edh-web` and `edh-api`. Use the Tempo Explore panel at the bottom to pivot by `mtgfr.table.id`.",
        "mode": "markdown"
      },
      "pluginVersion": "12.0.0",
      "title": "Dashboard notes",
      "type": "text"
    },
    {
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "description": "BFF HTTP spans per second grouped by route.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 4
      },
      "id": 2,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "query": "{ resource.service.name = \"edh-web\" && span.http.route != nil } | rate() by (span.http.route)",
          "queryType": "traceql",
          "refId": "A"
        }
      ],
      "title": "BFF HTTP rate by route",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "description": "BFF HTTP 5xx spans per second grouped by route and status.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
